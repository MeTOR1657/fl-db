POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=mydb
# Host port on the SSH server. PostgreSQL stays on port 5432 in Docker.
POSTGRES_PORT=6013
POSTGRES_HOST=localhost
POSTGRES_APP_USER=appuser
POSTGRES_APP_PASSWORD=replace_with_strong_app_password
DATABASE_URL=postgres://appuser:replace_with_strong_app_password@localhost:6013/mydb
